{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://calculadorameubess-production.up.railway.app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.ploomes.com https://*.ploomes.app"
        }
      ]
    }
  ]
}
